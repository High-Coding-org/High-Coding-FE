{
  "compilerOptions": {
    "types": ["vite/client", "vite-plugin-svgr/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "esModuleInterop": true
  },
  "include": ["svg.d.ts", "src/**/*", "vite.config.ts"]
}
